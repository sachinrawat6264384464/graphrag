# ==============================================================================
# NEXUSAI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Enterprise Hybrid RAG + GraphRAG Intelligence Platform
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# --- Application Core ---
PROJECT_NAME="NexusAI"
ENVIRONMENT="development"              # development | staging | production
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="nexusai-insecure-dev-secret-key-change-in-production-min32bytes"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- PostgreSQL + pgvector (Relational & Dense Vector Storage) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nexusai
POSTGRES_PASSWORD=nexusai_dev_password
POSTGRES_DB=nexusai_db
DATABASE_URL=postgresql+asyncpg://nexusai:nexusai_dev_password@localhost:5432/nexusai_db

# --- Neo4j Graph Database (Knowledge Graph & Entity Relations) ---
# Bolt protocol URI
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexusai_dev_password
NEO4J_DATABASE=neo4j

# --- Redis (Caching, Rate Limiting, Celery Queue) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM & AI Providers ---
# Local first architecture (Ollama)
LLM_PROVIDER=ollama                     # ollama | openai | anthropic | groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b               # Suitable for 8GB RAM host

# --- Embeddings & Reranker ---
# Local embedding candidate (BGE-small for low-memory footprint: ~130MB, 384 dimensions)
EMBEDDING_PROVIDER=local                # local | huggingface | openai
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Cross-Encoder Reranker
RERANKER_PROVIDER=local                 # local | cross-encoder
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# --- Storage Settings ---
STORAGE_BACKEND=local                   # local | s3
LOCAL_STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50

# --- Frontend Client Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000

